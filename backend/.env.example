# FitGenius AI Backend Environment Variables
PROJECT_NAME="FitGenius AI"
PROJECT_VERSION="1.0.0"

# Secret key for JWT signing
SECRET_KEY="fitgenius_ai_super_secret_jwt_key_2026_fitness_pro"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database URL: SQLite default (zero-setup) or PostgreSQL
# DATABASE_URL="postgresql://fitgenius:fitgenius_password@localhost:5432/fitgenius_ai"
DATABASE_URL="sqlite:///./fitgenius.db"

# Optional OpenAI API Key (if omitted, FitGenius utilizes its built-in expert sports science engine)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
